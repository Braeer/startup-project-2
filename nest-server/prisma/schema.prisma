model ComplitedQuestion {
  id String @id @default(uuid())

  type CompletionStatus @default(success)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  caseId String
  case   Case   @relation(fields: [caseId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model Case {
  id String @id @default(uuid())

  title String

  type       String
  difficulty String

  fio          String
  age          Int
  gender       String
  analysis     String[]
  help         String
  clinicalCase String   @map("clinical_case")

  // answer   String[]
  // rightAns String   @map("right_ans")
  // help     String?

  answers       String[]
  correctAnswer String   @map("correct_answer")

  complitedQuestions ComplitedQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

