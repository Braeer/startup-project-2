generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model User {
  id String @id @default(uuid())

  email     String @unique
  password  String
  username  String
  specialty String @default("Общая практика")

  isVerified   Boolean @default(false)
  refreshToken String?

  favoriteHandBooks FavoriteHandBooks[]
  verificationCodes VerificationCode[]

  completedQuestions ComplitedQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationCode {
  id        String   @id @default(uuid())
  code      String
  expiresAt DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

